# Copie este arquivo para "application-local.properties" (mesma pasta) e preencha com
# valores reais. Esse segundo arquivo NUNCA deve ser commitado (ja esta no .gitignore).
#
# Para ativar, rode a aplicacao com a variavel de ambiente:
#   SPRING_PROFILES_ACTIVE=local
# (no IntelliJ: Run Configuration > Environment variables > SPRING_PROFILES_ACTIVE=local)
#
# Alternativa: em vez de usar este arquivo, defina as mesmas chaves como variaveis de
# ambiente do sistema operacional / da IDE. application.properties ja le todas elas via
# ${VAR_NAME}. Em producao, SEMPRE use variaveis de ambiente do servidor/plataforma de
# deploy, nunca um arquivo application-local.properties.

DB_PASSWORD=sua_senha_local_do_mysql

# Gere com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())"
# Minimo 32 bytes (256 bits) para HS256. Use um valor DIFERENTE em cada ambiente
# (local, staging, producao) e nunca reaproveite um valor que já foi commitado antes.
JWT_SECRET=gere_um_valor_aleatorio_de_pelo_menos_32_bytes_em_base64

# Credenciais de SMTP. Para Gmail, gere uma "Senha de app" dedicada em
# https://myaccount.google.com/apppasswords (exige verificacao em 2 etapas ativada).
# Nunca use a senha normal da conta aqui.
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_do_gmail
MAIL_FROM=seu_email@gmail.com
MAIL_FROM_NAME=Sistema de Reservas UniFil
